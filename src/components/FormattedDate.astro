---
export interface Props {
  date: Date;
  showTime?: boolean;
}

const { date, showTime = false } = Astro.props;
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString("nl-NL", {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "Europe/Amsterdam",
    })
  }
  {
    showTime && (
      <>
        {" "}
        {date.toLocaleTimeString("nl-NL", {
          hour: "2-digit",
          minute: "2-digit",
          hour12: false,
          timeZone: "Europe/Amsterdam",
        })}
      </>
    )
  }
</time>
