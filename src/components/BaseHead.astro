---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import "../styles/geensnor.scss";
import { SITE_TITLE, AUTHORS, DEFAULT_AUTHOR } from "../consts";
import { ClientRouter } from "astro:transitions";
import OpenGraphImage from "../assets/cropped-Vintage-823x400.jpg";

interface Props {
  title: string;
  description: string;
  author?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, author } = Astro.props;

const mastodonHandle =
  AUTHORS.find((a) => a.name === author)?.mastodon_handle ??
  DEFAULT_AUTHOR.mastodon_handle;
const mastodonURL =
  AUTHORS.find((a) => a.name === author)?.mastodon_url ??
  DEFAULT_AUTHOR.mastodon_url;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta content="width=device-width,initial-scale=1" name="viewport" />
<link href="/favicon.svg" rel="icon" type="image/svg+xml" />
<link href="/sitemap-index.xml" rel="sitemap" />
<link href="/human.json" rel="human-json" />
<link
  href="/rss.xml"
  rel="alternate"
  title={SITE_TITLE}
  type="application/rss+xml"
/>
<meta content={Astro.generator} name="generator" />

<!-- Canonical URL -->
<link href={canonicalURL} rel="canonical" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta content={title} name="title" />
<meta content={description} name="description" />

<!-- Open Graph -->
<meta content="website" property="og:type" />
<meta content={Astro.url} property="og:url" />
<meta content={title} property="og:title" />
<meta content={description} property="og:description" />
<meta content={OpenGraphImage.src} property="og:image" />
<meta
  content="Geensnor banner met vintage wielrenners"
  property="og:image:alt"
/>
<meta content="nl-NL" property="og:locale" />

<!-- Umami script om bezoekers te meten -->
<script
  data-website-id="2e5bd2a9-eb24-40d4-bc1d-703373e3f437"
  defer
  src="https://umami-bezoekers.vercel.app/script.js"></script>

<!-- Fediverse  -->

<link href={mastodonURL} rel="me" />
<meta content={mastodonHandle} name="fediverse:creator" />

<ClientRouter />
